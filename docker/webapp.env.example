# Hermes Web — copy to the repo root as `.env` and edit:
#   cp docker/webapp.env.example .env
#
# ── Login (required) ─────────────────────────────────────────────────────
# The dashboard binds beyond loopback inside the stack, so its auth gate is
# always on. Password login is the zero-infrastructure option:
HERMES_WEB_USERNAME=admin
# EITHER a plaintext password …
HERMES_WEB_PASSWORD=change-me
# … OR (preferred) a bcrypt hash, generated with:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'
#HERMES_WEB_PASSWORD_HASH=$2a$14$...

# ── TLS / domain ─────────────────────────────────────────────────────────
# A real domain pointing at this host gets automatic Let's Encrypt TLS.
# Leave as localhost for a self-signed cert (fine for LAN/tunnel use).
HERMES_WEB_DOMAIN=localhost

# ── File ownership on the data volume ────────────────────────────────────
# Match your host user so /opt/data stays readable outside the container:
#   HERMES_UID=$(id -u) HERMES_GID=$(id -g) ./docker/webapp-up.sh
HERMES_UID=10000
HERMES_GID=10000

# ── Features ─────────────────────────────────────────────────────────────
# Browser terminal pane (a shell INSIDE the container). 0 to disable.
HERMES_WEB_TERMINAL=1

# ── Model provider keys (add what you use) ───────────────────────────────
#OPENROUTER_API_KEY=
#OPENAI_API_KEY=
#ANTHROPIC_API_KEY=
# Groq also powers fast cloud speech-to-text for voice input:
#GROQ_API_KEY=
# Premium text-to-speech voices (edge-tts works with no key):
#ELEVENLABS_API_KEY=
